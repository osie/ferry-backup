# ferry-compute, the quiesce agent. Rendered by kolla-ansible; override from
# {{ node_custom_config }}/ferry/compute.yaml, which is merged over this file.
#
# One job: fsfreeze at the KVM level through libvirt's qemu-agent channel, and
# thaw afterwards. No data path, no database, no OpenStack credential.
# Optional by design — without it backups are crash-consistent, which is a
# supported mode, not a failure.

# The manager dials this node by the name Nova reports for it, which is the
# node's own hostname, which is also what this agent's certificate carries.
node_id: "{{ ansible_facts.hostname }}"

log:
  level: "{{ ferry_log_level }}"
  format: json
{% if ferry_log_file_enabled | bool %}
  file: /var/log/kolla/ferry/ferry-compute.log
  file_max_mib: {{ ferry_log_file_max_mib }}
  file_keep: {{ ferry_log_file_keep }}
{% endif %}

# mTLS by construction: the agent refuses to start without require_client_cert,
# because this endpoint can freeze production guests — and, where backup is
# enabled below, hands out the contents of them. Being signed by our CA is not
# enough either: the peer has to be a name on this list.
#
# The managers are on it because they ask for the freeze. Movers are on it only
# when the local-disk data path is enabled, because that is the only case in
# which a mover has any reason to call this node at all.
api:
  bind: "{{ api_interface_address | put_address_in_context('url') }}:{{ ferry_compute_api_port }}"
  tls:
    enabled: true
    cert_file: /etc/ferry/pki/compute-server.crt
    key_file: /etc/ferry/pki/compute-server.key
    client_ca_file: /etc/ferry/pki/ca.crt
    require_client_cert: true
    allowed_client_cns: {{ ([ferry_manager_client_cn]
      + (groups['ferry-mover'] | default([]) | map('regex_replace', '^', 'ferry-mover-') | list
         if ferry_local_disk_backup | bool else [])) | unique | list | to_json }}
    min_version: "1.3"

admin:
  enabled: true
  bind: "{{ ferry_admin_bind_address | put_address_in_context('url') }}:{{ ferry_compute_admin_port }}"
  metrics: true
  pprof: false

libvirt:
  # kolla's nova_libvirt mounts the host's /run straight through, so this is
  # the daemon's real socket. The role bind-mounts the DIRECTORY, so a
  # nova_libvirt restart that replaces the socket does not leave this agent
  # attached to a dead one.
  socket: /run/libvirt/libvirt-sock
  uri: "qemu:///system"
  connect_timeout: 10s
  # Shorter than freeze.max_duration, or a hung libvirt outlives the watchdog
  # that exists to save the guest.
  call_timeout: 10s
  reconnect_backoff: 2s

freeze:
  # A ceiling on damage, not a target. The freeze window itself is milliseconds
  # because every snapshot inside it is a metadata operation — this is
  # what bounds the outage if the manager that asked for the freeze dies
  # mid-backup.
  max_duration: {{ ferry_max_freeze }}
  watchdog_interval: 1s
  thaw_retries: 5
  thaw_retry_interval: 2s
  # freeze_duration_ms is a safety metric. If it trends toward the
  # qemu-agent timeout, Ferry is about to freeze a production database and fail
  # to thaw it.
  warn_above: 2s
  # On a host path, so the agent's own crash is not a way to leave a guest
  # frozen: a restarted agent reads this and thaws before it serves.
  state_file: /var/lib/ferry/compute/freezes.json
  # Freezing every guest on a hypervisor at once is a self-inflicted outage.
  max_concurrent: 2

# The local-disk data path: pull-mode backup sessions over NBD, served to
# movers that hold a certificate named above.
#
# Off unless the deployment turned it on. With it off this agent freezes and
# thaws and does nothing else, which is what it has always done.
backup:
  enabled: {{ ferry_local_disk_backup | bool | lower }}
{% if ferry_local_disk_backup | bool %}
  # Inside kolla's `libvirtd` volume, because the process that has to OPEN these
  # is QEMU, not this agent. libvirt and QEMU run in nova_libvirt; a path only
  # this container can see fails at blockdev-add with "No such file or
  # directory", naming a file this agent has just successfully created.
  #
  # It grows with guest writes for the life of a session, so keep it off the
  # filesystem holding the instances: filling that one stops the guests.
  scratch_dir: {{ ferry_compute_scratch_dir }}
  # Unix sockets rather than TCP, and not negotiable: the NBD export is
  # unauthenticated, and a TCP one would put an unauthenticated read of every
  # guest disk on this node on the network.
  socket_dir: {{ ferry_compute_socket_dir }}
  # On the host path this agent owns, not in the libvirtd volume: a restarted
  # agent reads it to find and end the sessions it started.
  state_file: {{ ferry_compute_state_file }}
  # The one deadline a working mover cannot push back. default_ttl is an IDLE
  # deadline, renewed on every call; this one is not renewed by anything.
  max_duration: {{ ferry_compute_backup_max_duration }}
  default_ttl: {{ ferry_compute_backup_default_ttl }}
  watchdog_interval: 30s
  max_concurrent: {{ ferry_compute_backup_max_concurrent }}
  max_scratch_bytes: {{ ferry_compute_max_scratch_bytes }}
  read_timeout: 2m
{% endif %}
